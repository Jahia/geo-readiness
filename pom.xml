<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>jahia-modules</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>8.2.0.0</version>
    </parent>
    <!-- The community namespace, not org.jahia.se.modules: this is a community
         module now. The Java package deliberately does not follow. It names the
         OSGi configuration PID, so moving it would orphan every deployed
         .cfg file, and content-reports-react ships the same way. -->
    <groupId>org.jahia.community</groupId>
    <artifactId>geo-readiness</artifactId>
    <name>GEO Readiness</name>
    <version>1.4.0-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <description>jContent UI extension - can AI crawlers actually read this page? Server-side fetch per AI bot user agent, initial-HTML checks, robots.txt and llms.txt readiness.</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git@github.com:Jahia/geo-readiness.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/geo-readiness.git</developerConnection>
        <url>https://github.com/Jahia/geo-readiness</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- jcontent hosts the UI; robots and llms own the mixins the site-files
             editor writes. Naming them means Jahia refuses to start this module
             rather than failing at the first write. -->
        <jahia-depends>default,jcontent,robots,llms</jahia-depends>
        <yarn.arguments>build:production</yarn.arguments>
        <!-- Sonar keys a project by groupId:artifactId, so moving the groupId
             would start an empty project: no reference branch, every line of
             the module counted as new code, and the gate failing on a backlog
             nobody just wrote. The key is an identifier, not an address, so it
             stays where the analyses are. A Sonar administrator can rename the
             project key, after which this property is deleted. -->
        <sonar.projectKey>org.jahia.se.modules:geo-readiness</sonar.projectKey>
    </properties>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-Name>GEO Readiness</Bundle-Name>
                        <_dsannotations>*</_dsannotations>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>src/main/resources/javascript/apps</directory>
                            <includes><include>*</include></includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.1</version>
                <executions>
                    <execution>
                        <id>npm install node and yarn</id>
                        <phase>generate-resources</phase>
                        <goals><goal>install-node-and-yarn</goal></goals>
                        <configuration>
                            <nodeVersion>v22.21.0</nodeVersion>
                            <yarnVersion>v1.22.22</yarnVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn install</id>
                        <phase>generate-resources</phase>
                        <goals><goal>yarn</goal></goals>
                    </execution>
                    <execution>
                        <id>yarn build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>yarn</goal></goals>
                        <configuration>
                            <arguments>${yarn.arguments}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <yarn.arguments>webpack</yarn.arguments>
            </properties>
        </profile>
    </profiles>
</project>
