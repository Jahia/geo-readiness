# Read by @jahia/cypress's set-env.sh, which sources .env when it exists and this
# file otherwise. The CI action overrides most of these from the workflow inputs;
# the values here are what makes a local `docker compose up` work.
#
# Copy to .env before editing. .env is git-ignored.

# The module under test, as env.run.sh checks it is installed before running a
# single spec. A wrong value here fails the run with a named error instead of
# letting every spec fail on a missing servlet.
MODULE_ID=geo-readiness

# Jahia. The community image needs no license; the EE image does.
JAHIA_IMAGE=jahia/jahia-dev:8.2.4.0
JAHIA_LICENSE=
JAHIA_URL=http://jahia:8080
JAHIA_HOST=jahia
JAHIA_PORT=8080
JAHIA_USERNAME=root
JAHIA_PASSWORD=root1234
SUPER_USER_PASSWORD=root1234

# The tests container. Built from tests/Dockerfile by the CI action; only needed
# locally if you run the suite inside Docker rather than from your own machine.
TESTS_IMAGE=geo-readiness-tests:latest

# Applied to the instance before the suite runs.
MANIFEST=provisioning-manifest-build.yml

# Jahia Nexus, for modules resolved from mvn: coordinates. Not needed for the
# community image plus a locally built jar.
NEXUS_USERNAME=
NEXUS_PASSWORD=

TIMEZONE=UTC
SKIP_TESTS=false
TESTS_PROFILE=
