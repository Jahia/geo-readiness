# Read by set-env.sh, which sources .env when it exists and this file otherwise.
#
# Every value uses ${NAME:-default} so that anything already exported wins. That
# is what lets CI pass its own values in, and lets you override one for a single
# run without editing the file:
#
#   JAHIA_IMAGE=ghcr.io/jahia/jahia-ee-dev:8.2.4.0 ./ci.startup.sh
#
# Copy to .env before editing. .env is git-ignored and is where a license goes.

# The module under test. env.run.sh checks it is installed before running a
# single spec, so a wrong value here fails the run with a named error instead of
# letting every spec fail on a missing servlet.
MODULE_ID=${MODULE_ID:-geo-readiness}

# Jahia. This is the image the sibling harnesses use and the one that is actually
# pullable; `jahia/jahia-dev` is not published and fails with "pull access
# denied". The EE image wants a license, which is what JAHIA_LICENSE is for.
JAHIA_VERSION=${JAHIA_VERSION:-LATEST}
JAHIA_IMAGE=${JAHIA_IMAGE:-ghcr.io/jahia/jahia-ee-dev:8-SNAPSHOT}
JAHIA_LICENSE=${JAHIA_LICENSE:-""}
JAHIA_URL=${JAHIA_URL:-http://jahia:8080}
JAHIA_HOST=${JAHIA_HOST:-jahia}
JAHIA_PORT=${JAHIA_PORT:-8080}
JAHIA_USERNAME=${JAHIA_USERNAME:-root}
JAHIA_PASSWORD=${JAHIA_PASSWORD:-root1234}
SUPER_USER_PASSWORD=${SUPER_USER_PASSWORD:-root1234}

# The tests container. Built by ci.build.sh; only needed locally if you run the
# suite inside Docker rather than from your own machine.
TESTS_IMAGE=${TESTS_IMAGE:-geo-readiness-tests:latest}

# Applied to the instance before the suite runs.
MANIFEST=${MANIFEST:-provisioning-manifest-build.yml}

# Jahia Nexus, for modules resolved from mvn: coordinates.
NEXUS_USERNAME=${NEXUS_USERNAME:-}
NEXUS_PASSWORD=${NEXUS_PASSWORD:-}

TIMEZONE=${TIMEZONE:-UTC}
SKIP_TESTS=${SKIP_TESTS:-false}
TESTS_PROFILE=${TESTS_PROFILE:-}
